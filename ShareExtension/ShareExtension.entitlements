<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Reference only. Xcode writes this for you when you add the App Groups
     capability to the ShareExtension target. The group must match the one on
     the main app target and SharedInbox.appGroupID. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.sambulosenda.subradar</string>
	</array>
</dict>
</plist>
