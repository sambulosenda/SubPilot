    "Ask about your spending and renewals — answered privately on your device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag nach deinen Ausgaben und Verlängerungen — vertraulich auf deinem Gerät beantwortet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez des questions sur vos dépenses et renouvellements — réponses confidentielles sur votre appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta por tus gastos y renovaciones — respondido de forma privada en tu dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出や更新について質問できます。すべて端末内でプライベートに回答します。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi informazioni sulle tue spese e sui rinnovi — risposte private sul tuo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte sobre seus gastos e renovações — respondido em particular no seu dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출과 갱신에 대해 물어보세요 — 기기 안에서 비공개로 답해드려요."
          }
        }
      }
    },
    "Ask about your spending and renewals, answered privately on device, with Pro.": {
