    "You've reached the free limit of %lld subscriptions. Go unlimited with Pro.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das kostenlose Limit von %lld Abos erreicht. Mit Pro wird es unbegrenzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint la limite gratuite de %lld abonnements. Passez à l'illimité avec Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el límite gratuito de %lld suscripciones. Hazlo ilimitado con Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版の上限であるサブスク%lld件に達しました。Proで無制限にできます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il limite gratuito di %lld abbonamenti. Passa a illimitati con Pro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você atingiu o limite gratuito de %lld assinaturas. Tenha assinaturas ilimitadas com o Pro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 한도인 구독 %lld개에 도달했어요. Pro로 무제한 이용하세요."
          }
        }
      }
    },
    "Your subscriptions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Abos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos abonnements"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus suscripciones"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのサブスク"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi abbonamenti"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas assinaturas"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 구독"
          }
        }
      }
    },
    "Your subscriptions stay on your device and sync privately across your own devices via iCloud. Nothing is shared with us unless you email it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Abos bleiben auf deinem Gerät und werden über iCloud privat zwischen deinen eigenen Geräten synchronisiert. Nichts wird mit uns geteilt, außer du schickst es uns per E-Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos abonnements restent sur votre appareil et se synchronisent en privé entre vos propres appareils via iCloud. Rien ne nous est communiqué, sauf si vous nous l'envoyez par e-mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus suscripciones permanecen en tu dispositivo y se sincronizan de forma privada entre tus propios dispositivos mediante iCloud. No se comparte nada con nosotros a menos que nos lo envíes por correo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクは端末内に保存され、iCloudを通じてご自身の端末間でプライベートに同期されます。あなたがメールで送らない限り、当社と共有されるものは何もありません。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi abbonamenti restano sul tuo dispositivo e si sincronizzano in privato tra i tuoi dispositivi tramite iCloud. Nulla viene condiviso con noi, a meno che tu non ce lo invii via email."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas assinaturas ficam no seu dispositivo e sincronizam em particular entre seus próprios dispositivos via iCloud. Nada é compartilhado com a gente, a menos que você envie por e-mail."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 기기 안에 남아 있으며 iCloud를 통해 본인의 기기 간에 비공개로 동기화됩니다. 직접 이메일로 보내지 않는 한 저희와 공유되는 것은 없어요."
          }
        }
      }
    },
    "Your subscriptions stay on your device. No account, no sign-up, and no sharing your bank.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Abos bleiben auf deinem Gerät. Kein Konto, keine Anmeldung und keine Weitergabe deiner Bankdaten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos abonnements restent sur votre appareil. Aucun compte, aucune inscription, et aucun partage de vos données bancaires."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus suscripciones permanecen en tu dispositivo. Sin cuenta, sin registro y sin compartir tu banco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクは端末内に保存されます。アカウント不要、登録不要、銀行情報の共有も不要です。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi abbonamenti restano sul tuo dispositivo. Nessun account, nessuna registrazione e nessuna condivisione dei dati bancari."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas assinaturas ficam no seu dispositivo. Sem conta, sem cadastro e sem compartilhar seu banco."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 기기 안에 남아 있어요. 계정도, 가입도, 은행 정보 공유도 필요 없어요."
          }
        }
      }
    },
    "Your subscriptions sync and back up across your devices via iCloud.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Abos werden über iCloud auf all deinen Geräten synchronisiert und gesichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos abonnements se synchronisent et se sauvegardent sur tous vos appareils via iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus suscripciones se sincronizan y se respaldan en todos tus dispositivos mediante iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクはiCloudを通じてご自身の端末間で同期・バックアップされます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi abbonamenti si sincronizzano e vengono salvati su tutti i tuoi dispositivi tramite iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas assinaturas sincronizam e fazem backup em todos os seus dispositivos via iCloud."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 iCloud를 통해 여러 기기에서 동기화·백업됩니다."
          }
        }
      }
    },
