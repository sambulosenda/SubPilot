    "Notifications are turned off in iOS Settings, so reminders won't appear.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind in den iOS-Einstellungen deaktiviert, daher erscheinen keine Erinnerungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées dans les réglages iOS, les rappels n'apparaîtront donc pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas en los Ajustes de iOS, así que los recordatorios no aparecerán."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの設定で通知がオフになっているため、リマインダーは表示されません。"
