    "We couldn't find any subscriptions to add.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten keine Abos zum Hinzufügen finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons trouvé aucun abonnement à ajouter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos podido encontrar suscripciones para añadir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加できるサブスクが見つかりませんでした。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo trovato abbonamenti da aggiungere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos encontrar assinaturas para adicionar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가할 구독을 찾지 못했어요."
          }
        }
      }
    },
    "We couldn't find subscriptions in that receipt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten in diesem Beleg keine Abos finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons trouvé aucun abonnement dans ce reçu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos podido encontrar suscripciones en ese recibo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのレシートからサブスクが見つかりませんでした。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo trovato abbonamenti in quella ricevuta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos encontrar assinaturas nesse recibo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 영수증에서 구독을 찾지 못했어요."
          }
        }
      }
    },
    "We couldn't spot recurring charges in this statement. Try a statement covering a longer period, or add subscriptions manually.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten in diesem Auszug keine wiederkehrenden Abbuchungen erkennen. Versuche einen Auszug über einen längeren Zeitraum oder füge Abos manuell hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas pu repérer de prélèvements récurrents dans ce relevé. Essayez un relevé couvrant une période plus longue, ou ajoutez les abonnements manuellement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos podido detectar cargos recurrentes en este extracto. Prueba con un extracto que cubra un periodo más largo o añade suscripciones manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この明細から定期的な請求を見つけられませんでした。より長い期間の明細を試すか、サブスクを手動で追加してください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a individuare addebiti ricorrenti in questo estratto conto. Prova un estratto conto che copra un periodo più lungo, oppure aggiungi gli abbonamenti manualmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos identificar cobranças recorrentes neste extrato. Tente um extrato de um período mais longo ou adicione assinaturas manualmente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 명세서에서 반복 청구를 찾지 못했어요. 더 긴 기간의 명세서를 사용하거나 구독을 직접 추가해 보세요."
          }
        }
      }
    },
    "We found these subscriptions in your receipt. Pick the ones to add.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben diese Abos in deinem Beleg gefunden. Wähle die aus, die du hinzufügen möchtest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons trouvé ces abonnements dans votre reçu. Choisissez ceux à ajouter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos encontrado estas suscripciones en tu recibo. Elige las que quieras añadir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートからこれらのサブスクが見つかりました。追加するものを選んでください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo trovato questi abbonamenti nella tua ricevuta. Scegli quelli da aggiungere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontramos estas assinaturas no seu recibo. Escolha as que você quer adicionar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영수증에서 이 구독들을 찾았어요. 추가할 항목을 선택하세요."
          }
        }
      }
    },
    "We look for charges that repeat on a regular schedule. Pick the ones you'd like to track.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir suchen nach Abbuchungen, die sich regelmäßig wiederholen. Wähle die aus, die du verfolgen möchtest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous recherchons les prélèvements qui se répètent à intervalles réguliers. Choisissez ceux que vous souhaitez suivre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscamos cargos que se repiten con regularidad. Elige los que quieras controlar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一定の周期で繰り返される請求を探します。管理したいものを選んでください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerchiamo addebiti che si ripetono con regolarità. Scegli quelli che vuoi monitorare."
          }
        },
        "pt-BR": {
          "stringUnit": {
