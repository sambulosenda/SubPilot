    "Spending, renewals, where to cut back — answered privately on your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgaben, Verlängerungen, wo du sparen kannst — vertraulich auf deinem Gerät beantwortet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gastos, renovaciones, dónde recortar — respondido de forma privada en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dépenses, renouvellements, où réduire — réponses confidentielles sur votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spese, rinnovi, dove tagliare — risposte private sul tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支出、更新、どこを削れるか——すべて端末内でプライベートに回答します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지출, 갱신, 어디서 줄일 수 있는지 — 기기 안에서 비공개로 답해드려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gastos, renovações, onde economizar — respondido em particular no seu dispositivo."
          }
        }
      }
    },
    "Spot recurring charges in your bank statement automatically, with Pro." : {
      "localizations" : {
