    "Keep all your recurring payments in one place and always know what's coming out next." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte alle wiederkehrenden Zahlungen an einem Ort und weißt immer, was als Nächstes abgebucht wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten todos tus pagos recurrentes en un solo sitio y sabe siempre qué se cobra a continuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez tous vos paiements récurrents au même endroit et sachez toujours ce qui sera prélevé ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni tutti i tuoi pagamenti ricorrenti in un unico posto e sappi sempre cosa verrà addebitato dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての定期支払いを一か所にまとめ、次に何が引き落とされるかを常に把握できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 정기 결제를 한곳에 모아 다음에 무엇이 빠져나가는지 늘 파악하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha todos os seus pagamentos recorrentes em um só lugar e saiba sempre o que vem a seguir."
          }
        }
      }
    },
