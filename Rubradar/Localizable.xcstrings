    "Track every subscription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse jedes Abo"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla cada suscripción"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez chaque abonnement"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitora ogni abbonamento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのサブスクを管理"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 구독을 추적하세요"
