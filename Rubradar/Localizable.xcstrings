    "These subscriptions were charged a different amount than you have saved. Selected ones will be updated to the new price." : {
      "comment" : "A footer explaining that selected price-updated subscriptions will be updated to their new prices.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei diesen Abos wurde ein anderer Betrag abgebucht als gespeichert. Ausgewählte werden auf den neuen Preis aktualisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A estas suscripciones se les cobró un importe distinto al guardado. Las seleccionadas se actualizarán al nuevo precio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces abonnements ont été débités d'un montant différent de celui enregistré. Les abonnements sélectionnés seront mis à jour au nouveau prix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per questi abbonamenti è stato addebitato un importo diverso da quello salvato. Quelli selezionati saranno aggiornati al nuovo prezzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのサブスクは保存された金額と異なる金額が請求されました。選択したものは新しい価格に更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 구독들은 저장된 금액과 다른 금액이 청구되었습니다. 선택한 항목은 새 가격으로 업데이트됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas assinaturas foram cobradas com um valor diferente do salvo. As selecionadas serão atualizadas para o novo preço."
          }
        }
      }
    },
