            "value": "無料トライアルを始める"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia la prova gratuita"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começar teste grátis"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험 시작"
          }
        }
      }
    },
    "Start with a free trial — and we'll remind you before it ends, including this one.": {
      "comment": "Subtitle for the \"onboarding\" paywall context.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit einer kostenlosen Testphase — und wir erinnern dich, bevor sie endet, auch bei dieser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par un essai gratuit — et nous vous préviendrons avant qu'il se termine, y compris celui-ci."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con una prueba gratis — y te avisaremos antes de que termine, incluida esta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアルから始めましょう。今回の分も含め、終了前にお知らせします。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con una prova gratuita — e ti avviseremo prima che finisca, inclusa questa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com um teste grátis — e a gente te lembra antes de ele acabar, inclusive deste."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험으로 시작하세요 — 이 건을 포함해 체험이 끝나기 전에 알려드려요."
          }
        }
      }
    },
