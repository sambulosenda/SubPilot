    "Used by “Open website” on the subscription. Known services open their site automatically even without a link.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird von „Website öffnen“ beim Abo verwendet. Bekannte Dienste öffnen ihre Website automatisch, auch ohne Link."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé par « Ouvrir le site web » sur l'abonnement. Les services connus ouvrent leur site automatiquement même sans lien."
          }
        },
        "es": {
          "stringUnit": {
