            "value": "Was ist mein teuerstes Abo?"
          }
        }
      }
    },
    "What's the fastest way to add a subscription?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie füge ich am schnellsten ein Abo hinzu?"
          }
        }
      }
    },
    "Where could I cut back?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo könnte ich sparen?"
          }
        }
      }
    },
    "Where is my data stored?": {
