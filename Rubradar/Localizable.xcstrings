    "The App Store receipt couldn't be verified. You haven't been charged — please try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App-Store-Quittung konnte nicht überprüft werden. Dir wurde nichts berechnet — bitte versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar el recibo del App Store. No se te ha cobrado — inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le reçu de l’App Store n’a pas pu être vérifié. Vous n’avez pas été débité — veuillez réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile verificare la ricevuta dell’App Store. Non ti è stato addebitato nulla — riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Storeのレシートを確認できませんでした。請求は発生していません。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 영수증을 확인할 수 없습니다. 결제되지 않았으니 다시 시도해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar o recibo da App Store. Você não foi cobrado — tente novamente."
          }
        }
      }
    },
    "The on-device assistant isn't available right now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der On-Device-Assistent ist gerade nicht verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente en el dispositivo no está disponible en este momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistant sur l’appareil n’est pas disponible pour le moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistente su dispositivo non è al momento disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンデバイスアシスタントは現在利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온디바이스 어시스턴트를 지금은 사용할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O assistente no dispositivo não está disponível no momento."
          }
        }
      }
    },
    "The on-device assistant needs an Apple Intelligence–capable device. Your other subscription features work as normal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der On-Device-Assistent benötigt ein Gerät mit Apple Intelligence. Alle anderen Funktionen funktionieren wie gewohnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente en el dispositivo necesita un dispositivo compatible con Apple Intelligence. El resto de funciones siguen funcionando con normalidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistant sur l’appareil nécessite un appareil compatible avec Apple Intelligence. Vos autres fonctionnalités fonctionnent normalement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistente su dispositivo richiede un dispositivo compatibile con Apple Intelligence. Le altre funzioni continuano a funzionare normalmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンデバイスアシスタントにはApple Intelligence対応デバイスが必要です。その他のサブスク機能は通常どおり使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온디바이스 어시스턴트는 Apple Intelligence 지원 기기가 필요합니다. 다른 구독 기능은 정상적으로 작동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O assistente no dispositivo precisa de um aparelho compatível com Apple Intelligence. Os demais recursos continuam funcionando normalmente."
          }
        }
      }
    },
    "then %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
