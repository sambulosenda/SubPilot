    "Apple Intelligence is still downloading its model. This finishes automatically — check back shortly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence lädt sein Modell noch. Das passiert automatisch — schau gleich wieder vorbei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence todavía está descargando su modelo. Termina automáticamente — vuelve en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence télécharge encore son modèle. Cela se termine automatiquement — revenez dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence sta ancora scaricando il modello. Si completa automaticamente — riprova tra poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligenceのモデルをダウンロード中です。自動的に完了するので、しばらくしてからお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 모델을 다운로드하는 중입니다. 자동으로 완료되니 잠시 후 다시 확인해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple Intelligence ainda está baixando o modelo. Isso termina sozinho — volte em instantes."
          }
        }
      }
    },
