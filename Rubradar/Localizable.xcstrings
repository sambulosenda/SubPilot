    "Spending, renewals, where to cut back — answered privately on your device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgaben, Verlängerungen, wo du sparen kannst — vertraulich auf deinem Gerät beantwortet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépenses, renouvellements, où réduire — réponses confidentielles sur votre appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastos, renovaciones, dónde recortar — respondido de forma privada en tu dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出、更新、どこを削れるか——すべて端末内でプライベートに回答します。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spese, rinnovi, dove tagliare — risposte private sul tuo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastos, renovações, onde economizar — respondido em particular no seu dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출, 갱신, 어디서 줄일 수 있는지 — 기기 안에서 비공개로 답해드려요."
          }
        }
      }
    },
    "Spot recurring charges in your bank statement automatically, with Pro.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkenne wiederkehrende Abbuchungen mit Pro automatisch in deinem Kontoauszug."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repérez automatiquement les prélèvements récurrents dans votre relevé bancaire, avec Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta cargos recurrentes en tu extracto bancario automáticamente, con Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proなら、銀行明細から定期的な請求を自動で見つけられます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Individua automaticamente gli addebiti ricorrenti nel tuo estratto conto, con Pro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifique cobranças recorrentes no seu extrato bancário automaticamente, com o Pro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro로 은행 명세서에서 반복 청구를 자동으로 찾아내세요."
          }
        }
      }
    },
    "Start Free Trial": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos testen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer l'essai gratuit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
