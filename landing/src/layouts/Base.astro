---
// Self-hosted so the page makes no third-party request. Weight axis only:
// the design uses 400-700 upright plus a 600 italic for the accented word.
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/instrument-sans/wght-italic.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  SITE_NAME,
  APP_STORE_URL,
  AUTHOR_NAME,
  AUTHOR_SAME_AS,
  SCHEMA_ID,
} from '../consts';
import en from '../i18n/en';

interface Props {
  title: string;
  description: string;
  /** Emit the SoftwareApplication JSON-LD block. Home page only. */
  structuredData?: boolean;
  /** BCP 47 tag for <html lang>. */
  lang?: string;
  /** Locale strings module; drives the header and footer chrome. */
  strings?: typeof en;
  /** hreflang alternates, for pages that exist in more than one language. */
  alternates?: { hreflang: string; href: string }[];
  /** Root-relative path to a page-specific share card. */
  ogImage?: string;
  /** Alt text for the share card, for the handful of readers that use it. */
  ogImageAlt?: string;
}

const {
  title,
  description,
  structuredData = false,
  lang = 'en',
  strings = en,
  alternates,
  ogImage = '/assets/og-card.png',
  ogImageAlt = `${SITE_NAME} — subscription tracker for iPhone`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

const absolute = (id: string) => new URL(id, Astro.site).href;

// Emitted on every page, not just the home page: that's what lets the article
// bylines, the app listing and the site itself resolve to one entity.
const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': absolute(SCHEMA_ID.organization),
      name: SITE_NAME,
      url: new URL('/', Astro.site).href,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/assets/icon.png', Astro.site).href,
      },
      founder: { '@id': absolute(SCHEMA_ID.author) },
    },
    {
      '@type': 'Person',
      '@id': absolute(SCHEMA_ID.author),
      name: AUTHOR_NAME,
      url: new URL('/', Astro.site).href,
      ...(AUTHOR_SAME_AS.length > 0 && { sameAs: AUTHOR_SAME_AS }),
    },
    {
      '@type': 'WebSite',
      '@id': absolute(SCHEMA_ID.website),
      name: SITE_NAME,
      url: new URL('/', Astro.site).href,
      inLanguage: lang,
      publisher: { '@id': absolute(SCHEMA_ID.organization) },
    },
  ],
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE_NAME,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'iOS',
  url: new URL('/', Astro.site).href,
  installUrl: APP_STORE_URL,
  image: new URL('/assets/icon.png', Astro.site).href,
  description,
  publisher: { '@id': absolute(SCHEMA_ID.organization) },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  featureList: [
    'Track every subscription in one place',
    'Renewal and free-trial reminders before each charge',
    'Real monthly total across currencies',
    'On-device receipt scanning',
    'On-device AI assistant (Apple Intelligence)',
    'Private iCloud sync, no account required',
    'Home Screen and Lock Screen widgets',
  ],
  author: { '@id': absolute(SCHEMA_ID.author) },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#F4F3EF" />

    <link rel="icon" type="image/png" href="/assets/icon.png" />
    <link rel="apple-touch-icon" href="/assets/icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      alternates?.map((alt) => (
        <link
          rel="alternate"
          hreflang={alt.hreflang}
          href={new URL(alt.href, Astro.site).href}
        />
      ))
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(siteGraph)} />

    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      )
    }
  </head>

  <body>
    <Header t={strings.header} />
    <main>
      <slot />
    </main>
    <Footer t={strings.footer} />
  </body>
</html>
