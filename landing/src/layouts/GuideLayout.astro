---
import Base from './Base.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import { SITE_NAME, SCHEMA_ID } from '../consts';
import type { CollectionEntry } from 'astro:content';
import en from '../i18n/en';

interface Props {
  guide:
    | CollectionEntry<'guides'>
    | CollectionEntry<'cancel'>
    | CollectionEntry<'guidesDe'>
    | CollectionEntry<'cancelDe'>;
  /** Breadcrumb parent; defaults to the guides index. */
  section?: { name: string; href: string };
  lang?: string;
  strings?: typeof en;
  alternates?: { hreflang: string; href: string }[];
  /** Sibling pages to link to. See lib/related.ts for how they're picked. */
  related?: { title: string; href: string }[];
}

const {
  guide,
  section = { name: 'Guides', href: '/guides/' },
  lang = 'en',
  strings = en,
  alternates,
  related = [],
} = Astro.props;
const t = strings.guide;
const badge = strings.badge;
const { title, description, pubDate, updatedDate, faq } = guide.data;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: lang,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  datePublished: pubDate.toISOString().slice(0, 10),
  dateModified: (updatedDate ?? pubDate).toISOString().slice(0, 10),
  image: new URL('/assets/og-card.png', Astro.site).href,
  author: { '@id': new URL(SCHEMA_ID.author, Astro.site).href },
  publisher: { '@id': new URL(SCHEMA_ID.organization, Astro.site).href },
  isPartOf: { '@id': new URL(SCHEMA_ID.website, Astro.site).href },
};

// Same questions the reader sees below, machine-readable.
const faqSchema = faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(lang === 'en' ? '/' : `/${lang}/`, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: section.name, item: new URL(section.href, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};

const dateShown = (updatedDate ?? pubDate).toLocaleDateString(t.dateLocale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base
  title={`${title} — ${SITE_NAME}`}
  description={description}
  lang={lang}
  strings={strings}
  alternates={alternates}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  {
    faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )
  }

  <article class="prose">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={strings.header.homeHref}>{t.crumbHome}</a><span aria-hidden="true">/</span><a href={section.href}>{section.name}</a>
    </nav>
    <h1>{title}</h1>
    <p class="dateline">
      {updatedDate ? t.updated : t.published}<time
        datetime={(updatedDate ?? pubDate).toISOString().slice(0, 10)}
      >
        {dateShown}
      </time>
    </p>

    <div class="body">
      <slot />
    </div>

    {
      faq && faq.length > 0 && (
        <section class="faq" aria-labelledby="faq-heading">
          <h2 id="faq-heading">{t.faqTitle}</h2>
          <div class="faq-list">
            {faq.map((item) => (
              <details>
                <summary>
                  {item.q}
                  <span class="plus" aria-hidden="true">
                    +
                  </span>
                </summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <nav class="related" aria-labelledby="related-heading">
          <h2 id="related-heading">{t.relatedTitle}</h2>
          <ul>
            {related.map((item) => (
              <li>
                <a href={item.href}>{item.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <aside class="cta">
      <div>
        <h2>{t.ctaTitle}</h2>
        <p>{t.ctaBody}</p>
      </div>
      <AppStoreBadge t={badge} />
    </aside>
  </article>
</Base>

<style>
  .prose {
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(40px, 5vw, 64px) var(--gutter) clamp(72px, 9vw, 110px);
  }

  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 14px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .crumbs span {
    color: var(--ink-dim);
  }

  h1 {
    font-size: clamp(32px, 4vw, 46px);
    line-height: 1.08;
    letter-spacing: -0.028em;
    margin: 0 0 10px;
  }

  .dateline {
    color: var(--ink-dim);
    font-size: 14px;
    margin: 0 0 2.2em;
  }

  /* Rendered markdown (scoped to .body so the CTA badge is untouched) */
  .body :global(h2) {
    font-size: 22px;
    letter-spacing: -0.015em;
    margin: 2.2em 0 0.6em;
  }

  .body :global(h3) {
    font-size: 18px;
    letter-spacing: -0.01em;
    margin: 1.8em 0 0.5em;
  }

  .body :global(p),
  .body :global(li) {
    color: var(--ink-dim);
    line-height: 1.65;
  }

  .body :global(p),
  .body :global(ul),
  .body :global(ol) {
    max-width: 68ch;
  }

  .body :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .body :global(em) {
    color: inherit;
  }

  .body :global(ul),
  .body :global(ol) {
    padding-left: 1.3em;
  }

  .body :global(li) {
    margin-bottom: 0.5em;
  }

  .body :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  .body :global(table) {
    border-collapse: collapse;
    margin: 1.2em 0;
    font-size: 15.5px;
  }

  .body :global(th),
  .body :global(td) {
    text-align: left;
    padding: 9px 22px 9px 0;
    border-bottom: 1px solid var(--line-strong);
    color: var(--ink-dim);
  }

  .body :global(th) {
    color: var(--ink);
    font-weight: 600;
  }

  /* Same disclosure pattern as the home-page FAQ, at article scale. */
  .faq {
    margin-top: clamp(44px, 5.5vw, 66px);
  }

  .faq h2,
  .related h2 {
    margin: 0 0 18px;
    font-size: 22px;
    letter-spacing: -0.015em;
  }

  .faq-list {
    display: grid;
    border-top: 1px solid var(--line-strong);
  }

  details {
    border-bottom: 1px solid var(--line-strong);
  }

  summary {
    cursor: pointer;
    padding: 18px 0;
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .plus {
    color: var(--accent-ink);
    font-weight: 400;
    font-size: 20px;
    line-height: 1;
    transition: transform 0.25s var(--ease);
    flex: none;
  }

  details[open] .plus {
    transform: rotate(45deg);
  }

  details p {
    margin: 0;
    padding: 0 0 20px;
    color: var(--ink-dim);
    line-height: 1.6;
    max-width: 62ch;
  }

  .related {
    margin-top: clamp(44px, 5.5vw, 66px);
  }

  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line-strong);
  }

  .related li {
    border-bottom: 1px solid var(--line-strong);
  }

  .related a {
    display: block;
    padding: 15px 0;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    transition: color 0.2s;
  }

  .related a:hover {
    color: var(--accent-ink);
  }

  .cta {
    margin-top: clamp(48px, 6vw, 72px);
    background: var(--band);
    border: 1px solid var(--line-soft);
    border-radius: 20px;
    padding: 30px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
  }

  .cta h2 {
    margin: 0 0 8px;
    font-size: 20px;
    letter-spacing: -0.015em;
  }

  .cta p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 15.5px;
    max-width: 44ch;
  }
</style>
