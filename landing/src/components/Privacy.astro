---
import en from '../i18n/en';

const { t = en.privacy } = Astro.props;
---

<section id="privacy">
  <div class="wrap inner">
    <div class="copy">
      <span class="kicker kicker--rule">{t.kicker}</span>
      <h2 set:html={t.titleHtml} />
      <p>{t.body}</p>
    </div>

    <dl class="facts">
      {
        t.facts.map((fact: { label: string; value: string }) => (
          <div class="fact">
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  section {
    background: var(--night);
    color: var(--night-ink);
  }

  .inner {
    padding-block: clamp(84px, 10vw, 140px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  .kicker {
    color: var(--night-accent);
    margin-bottom: 22px;
  }

  h2 {
    margin: 0 0 20px;
    font-size: clamp(36px, 4.6vw, 62px);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  h2 :global(em) {
    color: var(--night-accent);
  }

  .copy p {
    margin: 0;
    color: var(--night-dim);
    font-size: 18px;
    max-width: 46ch;
  }

  .facts {
    margin: 0;
    display: grid;
    gap: 1px;
    background: var(--night-line);
    border: 1px solid var(--night-line);
    border-radius: 20px;
    overflow: hidden;
  }

  .fact {
    background: var(--night);
    padding: 22px 26px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
  }

  dt {
    font-size: 15.5px;
    font-weight: 500;
  }

  dd {
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 24px;
    color: var(--night-accent);
    line-height: 1;
    white-space: nowrap;
  }
</style>
