---
import en from '../i18n/en';

const { t = en.how } = Astro.props;

const numbers = ['01', '02', '03'];
---

<section id="how" class="wrap">
  <div class="head">
    <h2 set:html={t.titleHtml} />
    <p>{t.lead}</p>
  </div>

  <div class="hairline-grid steps">
    {
      t.steps.map((step: { title: string; body: string }, i: number) => (
        <div class="step">
          <span class="n">{numbers[i]}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  section {
    padding-block: clamp(76px, 9vw, 124px);
  }

  .head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(28px, 4vw, 64px);
    align-items: end;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  h2 {
    margin: 0;
    font-size: clamp(34px, 4.2vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.028em;
  }

  .head p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 18px;
    max-width: 44ch;
  }

  .steps {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .step {
    background: var(--cell);
    padding: 38px 32px 42px;
  }

  .n {
    display: block;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 30px;
    line-height: 1;
    color: var(--accent);
    margin-bottom: 20px;
  }

  h3 {
    margin: 0 0 10px;
    font-size: 20px;
    letter-spacing: -0.015em;
  }

  .step p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 15.5px;
  }
</style>
