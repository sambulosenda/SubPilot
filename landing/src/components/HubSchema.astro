---
import { SCHEMA_ID } from '../consts';

/**
 * Structured data for a listing page. Emits the breadcrumb the detail pages
 * already carry (so the hub isn't the one rung missing from the ladder) plus
 * an ItemList naming everything it links to, which is how a hub tells Google
 * it is an index rather than a thin page of links.
 */
interface Props {
  /** Name of this hub, e.g. "Cancel guides". */
  name: string;
  homeName: string;
  homeHref: string;
  items: { name: string; href: string }[];
  lang?: string;
}

const { name, homeName, homeHref, items, lang = 'en' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const absolute = (href: string) => new URL(href, Astro.site).href;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: homeName,
      item: absolute(homeHref),
    },
    { '@type': 'ListItem', position: 2, name },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': canonical,
  name,
  url: canonical,
  inLanguage: lang,
  isPartOf: { '@id': absolute(SCHEMA_ID.website) },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      url: absolute(item.href),
    })),
  },
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(breadcrumbSchema)}
/>
<script
  type="application/ld+json"
  set:html={JSON.stringify(collectionSchema)}
/>
