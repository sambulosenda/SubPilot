---
import Phone from './Phone.astro';
import calendar from '../assets/02-calendar.png';
import assistant from '../assets/03-assistant.png';
import receipt from '../assets/05-scan-receipt.png';
import en from '../i18n/en';

const { t = en.showcase } = Astro.props;

// Row order is fixed; only the copy is localized.
const images = [calendar, assistant, receipt];
---

<section class="band">
  <div class="wrap rows">
    {
      t.rows.map(
        (
          row: { kicker: string; titleHtml: string; body: string; alt: string },
          i: number
        ) => (
          <div class={i === 1 ? 'row row--flip' : 'row'}>
            <div class="copy">
              <span class="kicker">{row.kicker}</span>
              <h2 set:html={row.titleHtml} />
              <p>{row.body}</p>
              {i === 1 && (
                <div class="chips">
                  {t.chips.map((chip: string) => (
                    <span>{chip}</span>
                  ))}
                </div>
              )}
            </div>
            <div class="stage">
              <Phone src={images[i]!} alt={row.alt} crop />
            </div>
          </div>
        )
      )
    }
  </div>
</section>

<style>
  .band {
    background: var(--band);
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
  }

  .rows {
    padding-block: clamp(72px, 9vw, 120px);
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 7vw, 100px);
  }

  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }

  .stage {
    display: flex;
    justify-content: center;
  }

  .kicker {
    margin-bottom: 18px;
  }

  h2 {
    margin: 0 0 16px;
    font-size: clamp(30px, 3.6vw, 46px);
    line-height: 1.07;
    letter-spacing: -0.028em;
  }

  .copy p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 17.5px;
    max-width: 42ch;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 22px;
  }

  .chips span {
    background: var(--raised);
    border: 1px solid var(--line-soft);
    border-radius: 99px;
    padding: 7px 14px;
    font-size: 13.5px;
    color: var(--ink-dim);
  }

  /* Copy leads in the DOM on every row so the reading order stays consistent
     when the grid collapses; the alternation is a desktop-only flip. */
  @media (min-width: 700px) {
    .row--flip .copy {
      order: 2;
    }
  }
</style>
