---
import AppStoreBadge from './AppStoreBadge.astro';
---

<section>
  <div class="wrap inner">
    <img
      src="/assets/icon.png"
      width="1024"
      height="1024"
      loading="lazy"
      alt="SubHelm app icon"
    />
    <h2>Take control of your<br class="hold" /> recurring spending.</h2>
    <p>Free on the App Store. No account, no ads, no tracking.</p>
    <AppStoreBadge />
  </div>
</section>

<style>
  section {
    border-top: 1px solid var(--line-soft);
    background: var(--band);
  }

  .inner {
    padding-block: clamp(76px, 9vw, 124px);
    text-align: center;
  }

  img {
    width: 82px;
    height: 82px;
    border-radius: 20px;
    display: block;
    margin: 0 auto 28px;
    box-shadow: 0 22px 50px -22px rgba(15, 22, 19, 0.5);
  }

  h2 {
    margin: 0 0 18px;
    font-size: clamp(34px, 4.4vw, 58px);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  p {
    margin: 0 0 34px;
    color: var(--ink-dim);
    font-size: 18px;
  }

  @media (max-width: 720px) {
    .hold {
      display: none;
    }
  }
</style>
