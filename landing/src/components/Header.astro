---
import { SITE_NAME, APP_STORE_URL } from '../consts';
---

<header>
  <div class="wrap bar">
    <a class="brand" href="/">
      <img src="/assets/icon.png" alt="" width="30" height="30" />
      {SITE_NAME}
    </a>
    <nav>
      <a class="section-link" href="/#how">How it works</a>
      <a class="section-link" href="/#features">Features</a>
      <a class="section-link" href="/#privacy">Privacy</a>
      <a class="section-link" href="/guides/">Guides</a>
      <a class="cta" href={APP_STORE_URL}>Get the app</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(244, 243, 239, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(15, 22, 19, 0.08);
  }

  .bar {
    padding-block: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-weight: 600;
    font-size: 16.5px;
    letter-spacing: -0.01em;
  }

  .brand img {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    display: block;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 30px;
    white-space: nowrap;
  }

  .section-link {
    color: var(--ink-dim);
    font-size: 14.5px;
    font-weight: 500;
    transition: color 0.2s;
  }

  .section-link:hover {
    color: var(--ink);
  }

  .cta {
    background: var(--ink);
    color: var(--paper);
    font-size: 14px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 99px;
    transition: background 0.2s, color 0.2s;
  }

  .cta:hover {
    background: var(--accent-ink);
    color: #fff;
  }

  /* Three in-page anchors are a luxury on a phone; the CTA is not. */
  @media (max-width: 720px) {
    .section-link {
      display: none;
    }
  }
</style>
