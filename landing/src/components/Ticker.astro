---
import en from '../i18n/en';

const { t = en.ticker } = Astro.props;
---

<div class="strip">
  <div class="wrap row">
    {t.map((claim: string) => <span>{claim}</span>)}
  </div>
</div>

<style>
  .strip {
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    background: var(--band);
  }

  .row {
    padding-block: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 40px;
    align-items: center;
    justify-content: center;
  }

  span {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
</style>
