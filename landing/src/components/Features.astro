---
const features = [
  {
    title: 'Widgets',
    body: 'Your next renewal and monthly total on the Home and Lock Screen.',
  },
  {
    title: 'Smart reminders',
    body: 'A heads-up before each renewal, and before a free trial converts.',
  },
  {
    title: '200+ services',
    body: 'Netflix, Spotify, ChatGPT and more, added in a few seconds.',
  },
  {
    title: 'Profiles',
    body: 'Personal and work kept separate, each with its own total.',
  },
  {
    title: 'Multi-currency',
    body: 'Subscriptions in any currency, converted into one real total.',
  },
  {
    title: 'iCloud sync',
    body: 'Across your devices, through your own private iCloud.',
  },
];
---

<section id="features" class="wrap">
  <h2>Small things that make it stick.</h2>
  <div class="hairline-grid cells">
    {
      features.map((feature) => (
        <div class="cell">
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  section {
    padding-block: clamp(76px, 9vw, 124px);
  }

  h2 {
    margin: 0 0 clamp(36px, 4.5vw, 56px);
    font-size: clamp(34px, 4.2vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.028em;
    max-width: 20ch;
  }

  .cells {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .cell {
    background: var(--cell);
    padding: 34px 30px 38px;
    transition: background 0.25s;
  }

  .cell:hover {
    background: var(--raised);
  }

  h3 {
    margin: 0 0 9px;
    font-size: 17.5px;
    letter-spacing: -0.01em;
  }

  p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 15px;
  }
</style>
