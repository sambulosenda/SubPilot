---
import en from '../i18n/en';

const { t = en.features } = Astro.props;
---

<section id="features" class="wrap">
  <h2>{t.title}</h2>
  <div class="hairline-grid cells">
    {
      t.cells.map((cell: { title: string; body: string }) => (
        <div class="cell">
          <h3>{cell.title}</h3>
          <p>{cell.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  section {
    padding-block: clamp(76px, 9vw, 124px);
  }

  h2 {
    margin: 0 0 clamp(36px, 4.5vw, 56px);
    font-size: clamp(34px, 4.2vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.028em;
    max-width: 20ch;
  }

  .cells {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .cell {
    background: var(--cell);
    padding: 34px 30px 38px;
    transition: background 0.25s;
  }

  .cell:hover {
    background: var(--raised);
  }

  h3 {
    margin: 0 0 9px;
    font-size: 17.5px;
    letter-spacing: -0.01em;
  }

  p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 15px;
  }
</style>
