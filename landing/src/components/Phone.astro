---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Crop variant: bezel is open at the bottom and the screen fades out. */
  crop?: boolean;
  loading?: 'eager' | 'lazy';
}

const { src, alt, crop = false, loading = 'lazy' } = Astro.props;
---

<div class={crop ? 'phone phone--crop' : 'phone'}>
  <Image src={src} alt={alt} width={600} densities={[1, 2]} loading={loading} />
</div>

<style>
  .phone {
    position: relative;
    width: min(300px, 72vw);
    padding: 9px;
    background: var(--device);
    border-radius: 46px;
    box-shadow:
      0 50px 90px -40px rgba(15, 22, 19, 0.55),
      0 0 0 1px rgba(15, 22, 19, 0.08);
  }

  .phone :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 38px;
  }

  .phone--crop {
    width: min(288px, 70vw);
    padding: 9px 9px 0;
    border-radius: 44px 44px 0 0;
    height: clamp(360px, 40vw, 460px);
    overflow: hidden;
    box-shadow:
      0 44px 80px -38px rgba(15, 22, 19, 0.5),
      0 0 0 1px rgba(15, 22, 19, 0.08);
    -webkit-mask-image: linear-gradient(#000 74%, transparent 99%);
    mask-image: linear-gradient(#000 74%, transparent 99%);
  }

  .phone--crop :global(img) {
    border-radius: 36px 36px 0 0;
  }
</style>
