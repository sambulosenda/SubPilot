---
import en from '../i18n/en';

const { t = en.faq } = Astro.props;

// Same questions, machine-readable: earns the FAQ rich result in search.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.items.map((item: { q: string; a: string }) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section id="faq">
  <h2>{t.title}</h2>
  <div class="list">
    {
      t.items.map((item: { q: string; a: string }) => (
        <details>
          <summary>
            {item.q}
            <span class="plus" aria-hidden="true">
              +
            </span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  section {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(76px, 9vw, 120px) var(--gutter);
  }

  h2 {
    margin: 0 0 clamp(28px, 3.5vw, 44px);
    font-size: clamp(32px, 4vw, 50px);
    line-height: 1.06;
    letter-spacing: -0.028em;
  }

  .list {
    display: grid;
    border-top: 1px solid var(--line-strong);
  }

  details {
    border-bottom: 1px solid var(--line-strong);
  }

  summary {
    cursor: pointer;
    padding: 22px 0;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .plus {
    color: var(--accent-ink);
    font-weight: 400;
    font-size: 22px;
    line-height: 1;
    transition: transform 0.25s var(--ease);
    flex: none;
  }

  details[open] .plus {
    transform: rotate(45deg);
  }

  p {
    margin: 0;
    padding: 0 0 24px;
    color: var(--ink-dim);
    font-size: 16.5px;
    max-width: 62ch;
  }
</style>
