---
import { APP_STORE_URL } from '../consts';
---

<a href={APP_STORE_URL} aria-label="Download on the App Store">
  <svg viewBox="0 0 24 29" fill="currentColor" aria-hidden="true">
    <path
      d="M19.7 15.4c0-3.4 2.8-5 2.9-5.1-1.6-2.3-4-2.6-4.9-2.7-2.1-.2-4.1 1.2-5.1 1.2-1.1 0-2.7-1.2-4.4-1.2-2.3 0-4.4 1.3-5.5 3.3-2.4 4.1-.6 10.1 1.7 13.4 1.1 1.6 2.4 3.4 4.2 3.4 1.7-.1 2.3-1.1 4.3-1.1s2.6 1.1 4.4 1.1c1.8 0 2.9-1.6 4-3.3 1.3-1.9 1.8-3.7 1.8-3.8-.1 0-3.4-1.3-3.4-5.2zM16.3 5.2c.9-1.1 1.5-2.7 1.4-4.2-1.3.1-2.9.9-3.9 2-.8 1-1.6 2.6-1.4 4.1 1.5.1 3-.8 3.9-1.9z"
    ></path>
  </svg>
  <span class="lines">
    <small>Download on the</small>
    <strong>App Store</strong>
  </span>
</a>

<style>
  a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 14px;
    padding: 12px 22px 12px 18px;
    transition: transform 0.25s var(--ease), box-shadow 0.25s;
  }

  a:hover {
    color: var(--paper);
    transform: translateY(-2px);
    box-shadow: 0 18px 40px -18px rgba(15, 22, 19, 0.7);
  }

  svg {
    width: 23px;
    height: 28px;
    display: block;
  }

  .lines {
    line-height: 1.15;
    text-align: left;
  }

  small {
    display: block;
    font-size: 11px;
    font-weight: 500;
    opacity: 0.72;
  }

  strong {
    font-size: 17.5px;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
</style>
