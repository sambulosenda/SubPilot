---
import { SUPPORT_EMAIL, FEATUREBASE_URL, EULA_URL } from '../consts';
import en from '../i18n/en';

const { t = en.footer } = Astro.props;
---

<footer>
  <div class="wrap inner">
    <span>© 2026 Sambulo Senda</span>
    <div class="links">
      <a href={t.guidesHref}>{t.guides}</a>
      <a href={t.cancelHref}>{t.cancelGuides}</a>
      {/* nofollow while this still points at the pre-rebrand subdomain: no
          reason to hand every page's link equity to the old brand name. Drop
          the rel once the Featurebase rename in consts.ts is done. */}
      <a href={FEATUREBASE_URL} rel="nofollow">{t.featureRequests}</a>
      <a href="/privacy/">{t.privacyPolicy}</a>
      <a href={EULA_URL}>{t.terms}</a>
      <a href={`mailto:${SUPPORT_EMAIL}`}>{t.support}</a>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line-soft);
  }

  .inner {
    padding-block: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
    color: var(--ink-dim);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
  }

  a {
    color: var(--ink-dim);
    transition: color 0.2s;
  }

  a:hover {
    color: var(--accent-ink);
  }
</style>
