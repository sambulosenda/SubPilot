---
import { SUPPORT_EMAIL, FEATUREBASE_URL, EULA_URL } from '../consts';
---

<footer>
  <div class="wrap inner">
    <span>© 2026 Sambulo Senda</span>
    <div class="links">
      <a href={FEATUREBASE_URL}>Feature requests</a>
      <a href="/privacy/">Privacy policy</a>
      <a href={EULA_URL}>Terms of use</a>
      <a href={`mailto:${SUPPORT_EMAIL}`}>Support</a>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line-soft);
  }

  .inner {
    padding-block: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
    color: var(--ink-dim);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
  }

  a {
    color: var(--ink-dim);
    transition: color 0.2s;
  }

  a:hover {
    color: var(--accent-ink);
  }
</style>
