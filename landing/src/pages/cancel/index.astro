---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const services = (await getCollection('cancel')).sort((a, b) =>
  a.data.service.localeCompare(b.data.service)
);

const title = 'How to cancel any subscription — SubHelm';
const description =
  'Step-by-step cancellation guides for popular services: who bills you, where the cancel button lives, and the gotchas worth knowing first.';
---

<Base title={title} description={description}>
  <section class="wrap">
    <span class="kicker kicker--rule">Cancel guides</span>
    <h1>Cancel any subscription, <em>properly</em>.</h1>
    <p class="lead">
      The cancel button is always where the billing is, and that's the part
      people get wrong. Pick a service; each guide covers the Apple path, the
      direct path and the service's own gotchas.
    </p>

    <ul class="services">
      {
        services.map((entry) => (
          <li>
            <a href={`/cancel/${entry.id}/`}>{entry.data.service}</a>
          </li>
        ))
      }
    </ul>

    <p class="also">
      General advice instead? Start with
      <a href="/guides/cancel-subscriptions-iphone/"> how to cancel subscriptions on your iPhone</a>.
    </p>
  </section>
</Base>

<style>
  section {
    max-width: 820px;
    margin: 0 auto;
    padding-block: clamp(48px, 6vw, 84px) clamp(76px, 9vw, 120px);
  }

  .kicker {
    margin-bottom: 20px;
  }

  h1 {
    margin: 0 0 14px;
    font-size: clamp(36px, 4.4vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .lead {
    margin: 0 0 clamp(32px, 4vw, 44px);
    color: var(--ink-dim);
    font-size: 18px;
    max-width: 54ch;
  }

  .services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 22px;
    overflow: hidden;
  }

  .services a {
    display: block;
    background: var(--cell);
    padding: 20px 24px;
    color: var(--ink);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
    transition: background 0.2s, color 0.2s;
  }

  .services a:hover {
    background: var(--raised);
    color: var(--accent-ink);
  }

  .also {
    margin: clamp(28px, 4vw, 40px) 0 0;
    color: var(--ink-dim);
    font-size: 15.5px;
  }
</style>
