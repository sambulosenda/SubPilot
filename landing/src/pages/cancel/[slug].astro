---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import { ringNeighbours } from '../../lib/related';

export async function getStaticPaths() {
  const entries = await getCollection('cancel');
  const german = await getCollection('cancelDe');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      deSlug: german.find((g) => g.data.enSlug === entry.id)?.id ?? null,
      related: ringNeighbours(entries, entry.id).map((sibling) => ({
        title: sibling.data.title,
        href: `/cancel/${sibling.id}/`,
      })),
    },
  }));
}

const { entry, deSlug, related } = Astro.props;
const { Content } = await render(entry);

// hreflang pair only when a German twin exists (Hulu and HBO Max have none).
const alternates = deSlug
  ? [
      { hreflang: 'en', href: `/cancel/${entry.id}/` },
      { hreflang: 'de', href: `/de/kuendigen/${deSlug}/` },
      { hreflang: 'x-default', href: `/cancel/${entry.id}/` },
    ]
  : undefined;
---

<GuideLayout
  guide={entry}
  section={{ name: 'Cancel guides', href: '/cancel/' }}
  alternates={alternates}
  related={related}
>
  <Content />
</GuideLayout>
