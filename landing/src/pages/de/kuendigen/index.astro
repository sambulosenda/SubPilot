---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import HubSchema from '../../../components/HubSchema.astro';
import de from '../../../i18n/de';

const services = (await getCollection('cancelDe')).sort((a, b) =>
  a.data.service.localeCompare(b.data.service, 'de')
);

const title = 'Jedes Abo kündigen — SubHelm';
const description =
  'Schritt-für-Schritt-Kündigungs-Guides für beliebte Dienste: wer dich abrechnet, wo der Kündigen-Button liegt und welche Fallen vorher lauern.';

const alternates = [
  { hreflang: 'en', href: '/cancel/' },
  { hreflang: 'de', href: '/de/kuendigen/' },
  { hreflang: 'x-default', href: '/cancel/' },
];
---

<Base
  title={title}
  description={description}
  lang="de"
  strings={de}
  alternates={alternates}
>
  <HubSchema
    name="Kündigungs-Guides"
    homeName="Start"
    homeHref="/de/"
    lang="de"
    items={services.map((entry) => ({
      name: entry.data.service,
      href: `/de/kuendigen/${entry.id}/`,
    }))}
  />
  <section class="wrap">
    <span class="kicker">Kündigungs-Guides</span>
    <h1>Jedes Abo kündigen, <em>richtig</em>.</h1>
    <p class="lead">
      Der Kündigen-Button liegt immer dort, wo die Abrechnung liegt, und genau
      das übersehen die meisten. Wähle einen Dienst; jeder Guide deckt den
      Apple-Weg, den direkten Weg und die Eigenheiten des Anbieters ab.
    </p>

    <ul class="services">
      {
        services.map((entry) => (
          <li>
            <a href={`/de/kuendigen/${entry.id}/`}>{entry.data.service}</a>
          </li>
        ))
      }
    </ul>

    <p class="also">
      Lieber der allgemeine Überblick? Starte mit
      <a href="/de/guides/abos-kuendigen-iphone/"> Abos auf dem iPhone kündigen</a>.
    </p>
  </section>
</Base>

<style>
  section {
    max-width: 820px;
    margin: 0 auto;
    padding-block: clamp(48px, 6vw, 84px) clamp(76px, 9vw, 120px);
  }

  .kicker {
    margin-bottom: 20px;
  }

  h1 {
    margin: 0 0 14px;
    font-size: clamp(36px, 4.4vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .lead {
    margin: 0 0 clamp(32px, 4vw, 44px);
    color: var(--ink-dim);
    font-size: 18px;
    max-width: 54ch;
  }

  .services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 22px;
    overflow: hidden;
  }

  .services a {
    display: block;
    background: var(--cell);
    padding: 20px 24px;
    color: var(--ink);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
    transition: background 0.2s, color 0.2s;
  }

  .services a:hover {
    background: var(--raised);
    color: var(--accent-ink);
  }

  .also {
    margin: clamp(28px, 4vw, 40px) 0 0;
    color: var(--ink-dim);
    font-size: 15.5px;
  }
</style>
