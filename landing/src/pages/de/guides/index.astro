---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import HubSchema from '../../../components/HubSchema.astro';
import de from '../../../i18n/de';

const guides = (await getCollection('guidesDe')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = 'Guides — SubHelm';
const description =
  'Kurze, praktische Antworten rund um Abos: kündigen, echte Kosten kennen, keine Gratis-Testphase mehr bezahlen.';

const alternates = [
  { hreflang: 'en', href: '/guides/' },
  { hreflang: 'de', href: '/de/guides/' },
  { hreflang: 'x-default', href: '/guides/' },
];
---

<Base
  title={title}
  description={description}
  lang="de"
  strings={de}
  alternates={alternates}
>
  <HubSchema
    name="Guides"
    homeName="Start"
    homeHref="/de/"
    lang="de"
    items={guides.map((guide) => ({
      name: guide.data.title,
      href: `/de/guides/${guide.id}/`,
    }))}
  />
  <section class="wrap">
    <span class="kicker">Guides</span>
    <h1>Abos, <em>erklärt</em>.</h1>
    <p class="lead">
      Kurz und praktisch. Kein Bank-Login nötig, keine Sparversprechen, nichts
      zum Registrieren.
    </p>

    <div class="list">
      {
        guides.map((guide) => (
          <a class="item" href={`/de/guides/${guide.id}/`}>
            <h2>{guide.data.title}</h2>
            <p>{guide.data.description}</p>
            <span class="more" aria-hidden="true">
              Zum Guide →
            </span>
          </a>
        ))
      }
    </div>

    <p class="also">
      Du suchst einen bestimmten Dienst? Die
      <a href="/de/kuendigen/"> Kündigungs-Guides</a> decken Netflix, Spotify,
      DAZN und mehr ab, eine Seite pro Dienst.
    </p>
  </section>
</Base>

<style>
  section {
    max-width: 820px;
    margin: 0 auto;
    padding-block: clamp(48px, 6vw, 84px) clamp(76px, 9vw, 120px);
  }

  .kicker {
    margin-bottom: 20px;
  }

  h1 {
    margin: 0 0 14px;
    font-size: clamp(36px, 4.4vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .lead {
    margin: 0 0 clamp(36px, 4.5vw, 52px);
    color: var(--ink-dim);
    font-size: 18px;
    max-width: 52ch;
  }

  .list {
    display: grid;
    border-top: 1px solid var(--line-strong);
  }

  .item {
    display: block;
    padding: 26px 0 30px;
    border-bottom: 1px solid var(--line-strong);
    color: inherit;
  }

  .item h2 {
    margin: 0 0 8px;
    font-size: 21px;
    letter-spacing: -0.015em;
    transition: color 0.2s;
  }

  .item:hover h2 {
    color: var(--accent-ink);
  }

  .item p {
    margin: 0 0 10px;
    color: var(--ink-dim);
    font-size: 16px;
    max-width: 62ch;
  }

  .more {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--accent-ink);
  }

  .also {
    margin: clamp(28px, 4vw, 40px) 0 0;
    color: var(--ink-dim);
    font-size: 15.5px;
  }
</style>
