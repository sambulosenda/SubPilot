---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../../layouts/GuideLayout.astro';
import de from '../../../i18n/de';
import { ringNeighbours } from '../../../lib/related';

export async function getStaticPaths() {
  const guides = await getCollection('guidesDe');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: {
      guide,
      related: ringNeighbours(guides, guide.id).map((sibling) => ({
        title: sibling.data.title,
        href: `/de/guides/${sibling.id}/`,
      })),
    },
  }));
}

const { guide, related } = Astro.props;
const { Content } = await render(guide);

const alternates = [
  { hreflang: 'en', href: `/guides/${guide.data.enSlug}/` },
  { hreflang: 'de', href: `/de/guides/${guide.id}/` },
  { hreflang: 'x-default', href: `/guides/${guide.data.enSlug}/` },
];
---

<GuideLayout
  guide={guide}
  section={{ name: 'Guides', href: '/de/guides/' }}
  lang="de"
  strings={de}
  alternates={alternates}
  related={related}
>
  <Content />
</GuideLayout>
