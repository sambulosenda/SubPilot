---
import Base from '../layouts/Base.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';

const title = 'Page not found — SubHelm';
const description = 'That page does not exist. SubHelm is a private subscription tracker for iPhone.';
---

<Base title={title} description={description}>
  <section class="wrap lost">
    <span class="kicker kicker--rule">404</span>
    <h1>That page renewed as <em>nothing</em>.</h1>
    <p>
      The address doesn't exist. The app does: every subscription in one place,
      a reminder before each charge.
    </p>
    <div class="actions">
      <a class="home" href="/">Back to the homepage</a>
      <AppStoreBadge />
    </div>
  </section>
</Base>

<style>
  .lost {
    min-height: 55vh;
    padding-block: clamp(76px, 10vw, 140px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .kicker {
    margin-bottom: 22px;
  }

  h1 {
    margin: 0 0 16px;
    font-size: clamp(34px, 4.4vw, 58px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 18ch;
  }

  p {
    margin: 0 0 32px;
    color: var(--ink-dim);
    font-size: 18px;
    max-width: 46ch;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .home {
    font-weight: 600;
  }
</style>
